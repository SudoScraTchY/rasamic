<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>RasaMic.Server.App</RootNamespace>
    <Description>Avalonia GUI shell over the Rasa server engine: tray, QR pairing, mute hotkey.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="SharpHook" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RasaMic.Server\RasaMic.Server.csproj" />
    <ProjectReference Include="..\RasaMic.Core\RasaMic.Core.csproj" />
    <ProjectReference Include="..\RasaMic.Protocol\RasaMic.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>