<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Primary">#96660A</Color>
      <Color x:Key="Secondary">#A4593C</Color>
      <Color x:Key="Background">#F5F3EE</Color>
      <Color x:Key="Surface">#FFFFFF</Color>
      <Color x:Key="Surface2">#ECE8E0</Color>
      <Color x:Key="Border">#DDD6CA</Color>
      <Color x:Key="TextPrimary">#201D18</Color>
      <Color x:Key="TextSecondary">#5C564B</Color>
      <Color x:Key="TextMuted">#6E675C</Color>
      <Color x:Key="Success">#3E7A3E</Color>
      <Color x:Key="Error">#B3402F</Color>
      <Color x:Key="ButtonPrimary">#96660A</Color>
      <Color x:Key="ButtonPrimaryText">#FFFFFF</Color>
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#ECE8E0" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#DDD6CA" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6E675C" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#6E675C" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#ECE8E0" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#DDD6CA" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6E675C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Primary">#E2A33C</Color>
      <Color x:Key="Secondary">#D98A6C</Color>
      <Color x:Key="Background">#171512</Color>
      <Color x:Key="Surface">#201D19</Color>
      <Color x:Key="Surface2">#282420</Color>
      <Color x:Key="Border">#322D26</Color>
      <Color x:Key="TextPrimary">#EDEAE3</Color>
      <Color x:Key="TextSecondary">#A69F92</Color>
      <Color x:Key="TextMuted">#948C7F</Color>
      <Color x:Key="Success">#8FBE8F</Color>
      <Color x:Key="Error">#E08573</Color>
      <Color x:Key="ButtonPrimary">#EDEAE3</Color>
      <Color x:Key="ButtonPrimaryText">#201D18</Color>
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#282420" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#322D26" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#948C7F" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#948C7F" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#282420" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#322D26" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#948C7F" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>